# --- Private handoffs & QA evidence (kept locally, not published) -----------
/HANDOFF*.md
/evidence/

# --- Prior/local outputs not part of the published ten examples -------------
/out/
golden-out.txt
test-output.txt
*.log

# --- Generated intermediate textures (regenerate: python scripts/import-examples.py)
/examples/textures/

# --- Machine-specific render receipts (gallery GIFs + sheets stay public) -----
/examples/out/*_render.json
/examples/out/render-summary.json

# --- Vendor data pack (proprietary third-party content, never publish) -------
# hun0fx.pak is the vendor demo.pak: 104 vendor textures, 14 meshes, 312 fx
# definitions. PARITY.md section A and README Constraints both forbid shipping
# it. Kept local only; the loader that reads it (clone/src/wire-pak.js) is code
# and stays public.
*.pak

